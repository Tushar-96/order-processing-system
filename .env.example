# PostgreSQL
AUTH_DB_URL=jdbc:postgresql://localhost:5433/auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=auth_password

ORDER_DB_URL=jdbc:postgresql://localhost:5434/order_db
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=order_password

INVENTORY_DB_URL=jdbc:postgresql://localhost:5435/inventory_db
INVENTORY_DB_USERNAME=postgres
INVENTORY_DB_PASSWORD=inventory_password

# JWT
# Replace with a Base64-encoded secret of at least 32 random bytes.
JWT_SECRET=replace-with-a-long-base64-secret
JWT_EXPIRATION_MS=86400000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service locations used by the API Gateway
AUTH_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083

# Inventory sample data
SEED_PRODUCTS_ENABLED=true

# Password reset
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@orderflow.local
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRATION_MINUTES=15